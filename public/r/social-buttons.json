      "target": "components/ui/social-buttons.tsx",
      "content": "\"use client\";\n\nimport * as React from \"react\";\n\n/**\n * Social buttons — monochrome at rest, each blooms into its real brand hue on\n * hover (Instagram gets its authentic gradient). Self-contained: inline brand\n * glyphs and a scoped Instagram gradient, no icon library or global CSS needed.\n */\nexport type SocialLabel = \"GitHub\" | \"X\" | \"Instagram\" | \"YouTube\" | \"Discord\";\n\nexport type SocialItem = {\n  /** Drives both the glyph and the brand hue. */\n  label: SocialLabel;\n  href: string;\n};\n\n// simple-icons brand glyphs, 24×24 viewBox, filled with currentColor.\nconst GLYPHS: Record<SocialLabel, string> = {\n  GitHub:\n    \"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\",\n  X:\n    \"M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z\",\n  Instagram:\n    \"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z\",\n  YouTube:\n    \"M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z\",\n  Discord:\n    \"M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z\",\n};\n\n// Rest is monochrome; these are the hover hues. Instagram uses its gradient for\n// the glyph and its magenta for the soft background bloom.\nconst HUE: Record<SocialLabel, string> = {\n  GitHub: \"var(--foreground, currentColor)\",\n  X: \"var(--foreground, currentColor)\",\n  YouTube: \"#FF0033\",\n  Instagram: \"#D62976\",\n  Discord: \"#5865F2\",\n};\n\nconst DEFAULT_ITEMS: SocialItem[] = [\n  { label: \"GitHub\", href: \"https://github.com\" },\n  { label: \"X\", href: \"https://x.com\" },\n  { label: \"Instagram\", href: \"https://instagram.com\" },\n  { label: \"YouTube\", href: \"https://youtube.com\" },\n  { label: \"Discord\", href: \"https://discord.com\" },\n];\n\nexport function SocialButtons({\n  items = DEFAULT_ITEMS,\n  className = \"\",\n}: {\n  items?: SocialItem[];\n  className?: string;\n}) {\n  // Scoped id so multiple instances (and copy-paste users) never collide.\n  const gradientId = \"ig-grad-\" + React.useId().replace(/:/g, \"\");\n  return (\n    <div className={`flex items-center gap-1 ${className}`}>\n      <svg aria-hidden className=\"pointer-events-none absolute h-0 w-0\">\n        <defs>\n          <linearGradient id={gradientId} x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0%\" stopColor=\"#FEDA75\" />\n            <stop offset=\"25%\" stopColor=\"#FA7E1E\" />\n            <stop offset=\"50%\" stopColor=\"#D62976\" />\n            <stop offset=\"75%\" stopColor=\"#962FBF\" />\n            <stop offset=\"100%\" stopColor=\"#4F5BD5\" />\n          </linearGradient>\n        </defs>\n      </svg>\n      {items.map((item) => (\n        <SocialLink key={item.label} item={item} gradientId={gradientId} />\n      ))}\n    </div>\n  );\n}\n\nfunction SocialLink({\n  item,\n  gradientId,\n}: {\n  item: SocialItem;\n  gradientId: string;\n}) {\n  const [hover, setHover] = React.useState(false);\n  const isInstagram = item.label === \"Instagram\";\n  const hue = HUE[item.label];\n  return (\n    <a\n      href={item.href}\n      target=\"_blank\"\n      rel=\"noopener noreferrer\"\n      aria-label={item.label}\n      onMouseEnter={() => setHover(true)}\n      onMouseLeave={() => setHover(false)}\n      onFocus={() => setHover(true)}\n      onBlur={() => setHover(false)}\n      className=\"flex h-11 w-11 items-center justify-center rounded-xl text-muted-foreground/70 outline-none transition-[color,background-color,transform] duration-150 active:scale-95\"\n      style={{\n        color: hover && !isInstagram ? hue : undefined,\n        background: hover\n          ? `color-mix(in srgb, ${hue} 8%, transparent)`\n          : \"transparent\",\n      }}\n    >\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden>\n        <path\n          d={GLYPHS[item.label]}\n          fill={isInstagram && hover ? `url(#${gradientId})` : \"currentColor\"}\n        />\n      </svg>\n    </a>\n  );\n}\n\nexport default SocialButtons;\n"
    }
  ]
}
